local function createButton(text, order, callback)
    local Btn = Instance.new("TextButton")
    Btn.Size = UDim2.new(1, -40, 0, 35)
    Btn.BackgroundColor3 = Color3.fromRGB(40, 40, 50)
    Btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    Btn.Font = Enum.Font.GothamSemibold
    Btn.TextSize = 14
    Btn.Text = text
    Btn.LayoutOrder = order
    Btn.Parent = MainFrame
    
    local BtnCorner = Instance.new("UICorner")
    BtnCorner.CornerRadius = UDim.new(0, 6)
    BtnCorner.Parent = Btn
    
    Btn.MouseButton1Click:Connect(callback)
    return Btn
end

-- Method 1: ExperienceService (Used in both Rose and SXE Hubs)
createButton("Method 1: ExperienceService (Rose/SXE)", 2, function()
    StatusBox.TextColor3 = Color3.fromRGB(255, 255, 255)
    StatusBox.Text = "Testing ExperienceService..."
    
    local success, err = pcall(function()
        ExperienceService:LaunchExperience({ 
            placeId = PlaceId, 
            linkCode = LinkCode 
        })
    end)
    
    if success then
        StatusBox.TextColor3 = Color3.fromRGB(0, 255, 100)
        StatusBox.Text = "SUCCESS: ExperienceService fired."
    else
        StatusBox.TextColor3 = Color3.fromRGB(255, 50, 50)
        StatusBox.Text = "FAIL (ExperienceService): " .. tostring(err)
    end
end)

-- Method 2: TeleportService Fallback (Standard API)
createButton("Method 2: TeleportService Fallback", 3, function()
    StatusBox.TextColor3 = Color3.fromRGB(255, 255, 255)
    StatusBox.Text = "Testing TeleportService..."
    
    local success, err = pcall(function()
        TeleportService:TeleportToPrivateServer(PlaceId, LinkCode, {LocalPlayer})
    end)
    
    if success then
        StatusBox.TextColor3 = Color3.fromRGB(0, 255, 100)
        StatusBox.Text = "SUCCESS: TeleportService fired."
    else
        StatusBox.TextColor3 = Color3.fromRGB(255, 50, 50)
        StatusBox.Text = "FAIL (TeleportService): " .. tostring(err)
    end
end)

-- Method 3: Manual Clipboard 
createButton("Method 3: Copy Full Link", 4, function()
    local success, err = pcall(function()
        setclipboard(FullLink)
    end)
    
    if success then
        StatusBox.TextColor3 = Color3.fromRGB(150, 150, 255)
        StatusBox.Text = "COPIED: Paste into your browser."
    else
        StatusBox.TextColor3 = Color3.fromRGB(255, 50, 50)
        StatusBox.Text = "FAIL (Clipboard): Executor does not support setclipboard."
    end
end)

