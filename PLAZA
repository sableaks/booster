local function createViewportIcon(parent, source)

	local viewport = Instance.new("ViewportFrame")
	viewport.Size = UDim2.new(0, 70, 0, 70)
	viewport.Position = UDim2.new(0, 5, 0.5, 0)
	viewport.AnchorPoint = Vector2.new(0, 0.5)
	viewport.BackgroundTransparency = 1
	viewport.Ambient = Color3.fromRGB(200, 200, 200)
	viewport.LightColor = Color3.fromRGB(255, 255, 255)
	viewport.LightDirection = Vector3.new(-1, -1, -1)
	viewport.Parent = parent

	local worldModel = Instance.new("WorldModel")
	worldModel.Parent = viewport

	local camera = Instance.new("Camera")
	camera.FieldOfView = 50
	camera.Parent = viewport
	viewport.CurrentCamera = camera

	local clone

	local success = pcall(function()

		if source:IsA("Model") or source:IsA("BasePart") then
			source.Archivable = true
			clone = source:Clone()
		else
			local visual = source:FindFirstChildWhichIsA("Model", true)
				or source:FindFirstChildWhichIsA("BasePart", true)

			if visual then
				visual.Archivable = true
				clone = visual:Clone()
			end
		end
	end)

	if not success or not clone then
		return viewport
	end

	-- Remove expensive effects
	for _, obj in ipairs(clone:GetDescendants()) do

		if obj:IsA("Script")
			or obj:IsA("LocalScript")
			or obj:IsA("ModuleScript")
			or obj:IsA("Sound")
			or obj:IsA("ParticleEmitter")
			or obj:IsA("Trail")
			or obj:IsA("Beam")
			or obj:IsA("Smoke")
			or obj:IsA("Fire")
			or obj:IsA("Sparkles")
			or obj:IsA("BillboardGui")
			or obj:IsA("SurfaceGui") then

			obj:Destroy()
		end
	end

	clone.Parent = worldModel

	local primary

	if clone:IsA("Model") then
		primary =
			clone.PrimaryPart
			or clone:FindFirstChildWhichIsA("BasePart", true)
	else
		primary = clone
	end

	if primary then

		local size

		if clone:IsA("Model") then
			size = clone:GetExtentsSize()
		else
			size = clone.Size
		end

		local maxDim = math.max(size.X, size.Y, size.Z)

		if maxDim < 1 then
			maxDim = 3
		end

		local center = primary.Position

		if clone:IsA("Model") then
			clone:PivotTo(CFrame.new(0, 0, 0))
			primary = clone.PrimaryPart
				or clone:FindFirstChildWhichIsA("BasePart", true)
			center = primary and primary.Position or Vector3.zero
		else
			clone.CFrame = CFrame.new(0, 0, 0)
			center = Vector3.zero
		end

		local cameraDistance = maxDim * 1.6

		camera.CFrame = CFrame.new(
			center + Vector3.new(cameraDistance, maxDim * 0.15, cameraDistance),
			center
		)
	end

	return viewport
end

--// ============================================================
--// FIND PRIORITY BRAINROTS
--// ============================================================

local function findPriorityBrainrots(plot)

	local found = {}
	local seen = {}

	if not plot then
		return found
	end

	-- Only scan descendants of THIS base.
	-- No workspace-wide descendant scan.
	for _, obj in ipairs(plot:GetDescendants()) do

		if obj:IsA("Model") or obj:IsA("BasePart") then

			local normalized = normalizeName(obj.Name)

			if isPriorityAnimal(normalized) then

				if not seen[normalized] then

					seen[normalized] = true

					table.insert(found, {
						name = obj.Name,
						normalized = normalized,
						object = obj,
						priority = PRIORITY_LOOKUP[normalized]
					})
				end
			end
		end
	end

	table.sort(found, function(a, b)
		return a.priority < b.priority
	end)

	return found
end

