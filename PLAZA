--// ============================================================
--// UPDATE FRIEND BRAINROT PANEL
--// ============================================================

local function showFriendBrainrots(targetPlayer)

	if not targetPlayer or not targetPlayer.Parent then
		return
	end

	local plot = findPlotForPlayer(targetPlayer)

	brainrotPanelOpen = true
	brainrotPanel.Visible = true

	brainrotTitle.Text = targetPlayer.DisplayName
	brainrotSubtitle.Text = "@" .. targetPlayer.Name

	local image = getHeadshot(targetPlayer.UserId)

	if image then
		brainrotAvatar.Image = image
	end

	-- Clear previous rows
	for _, child in ipairs(brainrotList:GetChildren()) do
		if not child:IsA("UIListLayout")
			and not child:IsA("UIPadding") then

			child:Destroy()
		end
	end

	if not plot then

		local noPlot = Instance.new("TextLabel")
		noPlot.Size = UDim2.new(1, -10, 0, 50)
		noPlot.BackgroundTransparency = 1
		noPlot.Text = "No base found."
		noPlot.TextColor3 = Color3.fromRGB(180, 180, 195)
		noPlot.TextSize = 12
		noPlot.Font = Enum.Font.GothamMedium
		noPlot.Parent = brainrotList

		return
	end

	local brainrots = findPriorityBrainrots(plot)

	if #brainrots == 0 then

		local empty = Instance.new("TextLabel")
		empty.Size = UDim2.new(1, -10, 0, 70)
		empty.BackgroundTransparency = 1
		empty.Text = "No priority brainrots found."
		empty.TextColor3 = Color3.fromRGB(150, 150, 165)
		empty.TextSize = 12
		empty.Font = Enum.Font.GothamMedium
		empty.Parent = brainrotList

		return
	end

	for index, data in ipairs(brainrots) do
		createBrainrotRow(data, index)

		-- Small yield so a huge base doesn't freeze the client
		if index % 5 == 0 then
			task.wait()
		end
	end
end

