local plotCache = {}

local function findPlotForPlayer(targetPlayer)

	if plotCache[targetPlayer] and plotCache[targetPlayer].Parent then
		return plotCache[targetPlayer]
	end

	local plotsFolder = workspace:FindFirstChild("Plots")

	if not plotsFolder then
		return nil
	end

	local displayNameBase = targetPlayer.DisplayName .. "'s Base"
	local usernameBase = targetPlayer.Name .. "'s Base"

	for _, plot in ipairs(plotsFolder:GetChildren()) do

		local plotSign = plot:FindFirstChild("PlotSign")

		if plotSign then

			local surfaceGui = plotSign:FindFirstChild("SurfaceGui")

			if surfaceGui then

				local frame = surfaceGui:FindFirstChild("Frame")

				if frame then

					local textLabel = frame:FindFirstChild("TextLabel")

					if textLabel then

						local text = textLabel.Text

						if text == displayNameBase
							or text == usernameBase then

							plotCache[targetPlayer] = plot
							return plot
						end
					end
				end
			end
		end
	end

	return nil
end

--// ============================================================
--// CAMERA
--// ============================================================

local function lockCameraOnPlot(plot, targetPlayer)

	if not plot then
		return
	end

	local camera = workspace.CurrentCamera

	camera.CameraType = Enum.CameraType.Scriptable

	local plotSign = plot:FindFirstChild("PlotSign")

	if plotSign and plotSign:IsA("BasePart") then
		targetPlotSign = plotSign
	else
		targetPlotSign = plot:IsA("BasePart") and plot or nil
	end

	if not targetPlotSign then
		return
	end

	cameraLocked = true
	lockedPlot = plot
	lockedPlayer = targetPlayer

	unlockButton.Visible = true
	rotationFrame.Visible = true

	cameraAngle = 0

	local targetPos = targetPlotSign.Position

	camera.CFrame = CFrame.new(
		targetPos + Vector3.new(0, 2, -cameraDistance),
		targetPos
	)

	rotationLabel.Text = "Angle: 0°"
	sliderFill.Size = UDim2.new(0, 0, 1, 0)
	sliderKnob.Position = UDim2.new(0, -8, 0.5, -11)

	statusLabel.Text = "Camera locked on " .. targetPlayer.DisplayName
	statusLabel.TextColor3 = Color3.fromRGB(255, 200, 100)
end

local function unlockCamera()

	local camera = workspace.CurrentCamera

	if camera.CameraType == Enum.CameraType.Scriptable then
		camera.CameraType = Enum.CameraType.Custom
	end

	cameraLocked = false
	lockedPlot = nil
	lockedPlayer = nil
	targetPlotSign = nil

	unlockButton.Visible = false
	rotationFrame.Visible = false
end

--// ============================================================
--// CAMERA SLIDER
--// ============================================================

local isDraggingSlider = false

local function setCameraAngle(angle)

	cameraAngle = angle % 360

	rotationLabel.Text = "Angle: " .. math.floor(cameraAngle) .. "°"

	local percent = cameraAngle / 360

	sliderFill.Size = UDim2.new(percent, 0, 1, 0)
	sliderKnob.Position = UDim2.new(percent, -8, 0.5, -11)

	if not targetPlotSign or not cameraLocked then
		return
	end

	local camera = workspace.CurrentCamera
	local rad = math.rad(cameraAngle)

	local offset = Vector3.new(
		math.sin(rad) * cameraDistance,
		2,
		math.cos(rad) * cameraDistance
	)

	camera.CFrame = CFrame.new(
		targetPlotSign.Position + offset,
		targetPlotSign.Position
	)
end

local function updateSlider(input)

	local width = sliderTrack.AbsoluteSize.X

	if width <= 0 then
		return
	end

	local percent = math.clamp(
		(input.Position.X - sliderTrack.AbsolutePosition.X) / width,
		0,
		1
	)

	setCameraAngle(percent * 360)
end

sliderTrack.InputBegan:Connect(function(input)

	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		isDraggingSlider = true
		updateSlider(input)
	end
end)

UserInputService.InputEnded:Connect(function(input)

	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		isDraggingSlider = false
	end
end)

UserInputService.InputChanged:Connect(function(input)

	if isDraggingSlider
		and input.UserInputType == Enum.UserInputType.MouseMovement then

		updateSlider(input)
	end
end)

