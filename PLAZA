	local count = 0

	for _ in pairs(addedPlayers) do
		count += 1
	end

	if cameraLocked and lockedPlayer then
		statusLabel.Text = "Camera locked on " .. lockedPlayer.DisplayName
		statusLabel.TextColor3 = Color3.fromRGB(255, 200, 100)
		return
	end

	if count == 0 then
		statusLabel.Text = "No other players"
		statusLabel.TextColor3 = Color3.fromRGB(150, 150, 165)
	else
		statusLabel.Text =
			count .. " player" .. (count == 1 and "" or "s") .. " detected"

		statusLabel.TextColor3 = Color3.fromRGB(120, 220, 130)
	end
end

local function updatePlayerVisibility()

	local query = normalizeName(searchBox.Text)

	for targetPlayer, frame in pairs(playerFrames) do

		if frame and frame.Parent then

			if query == "" then

				frame.Visible = true

			else

				local username = normalizeName(targetPlayer.Name)
				local displayName = normalizeName(targetPlayer.DisplayName)

				frame.Visible =
					username:find(query, 1, true) ~= nil
					or displayName:find(query, 1, true) ~= nil
			end
		end
	end
end

