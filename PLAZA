--// Only names that actually exist in Animations.Animals
--// ============================================================

local ANIMAL_NAMES = {}
local ANIMAL_OBJECTS = {}

local function rebuildAnimalCache()

	table.clear(ANIMAL_NAMES)
	table.clear(ANIMAL_OBJECTS)

	if not ANIMALS_FOLDER then
		return
	end

	for _, obj in ipairs(ANIMALS_FOLDER:GetChildren()) do
		local name = string.lower(obj.Name)

		ANIMAL_NAMES[name] = true
		ANIMAL_OBJECTS[name] = obj
	end
end

rebuildAnimalCache()

if ANIMALS_FOLDER then
	ANIMALS_FOLDER.ChildAdded:Connect(function()
		rebuildAnimalCache()
	end)

	ANIMALS_FOLDER.ChildRemoved:Connect(function()
		rebuildAnimalCache()
	end)
end

--// ============================================================
--// HELPERS
--// ============================================================

local function normalizeName(name)
	return string.lower(
		string.gsub(
			string.gsub(tostring(name), "%s+", " "),
			"^%s*(.-)%s*$",
			"%1"
		)
	)
end

local function isPriorityAnimal(name)

	local normalized = normalizeName(name)

	-- Must exist in Animations.Animals
	if not ANIMAL_NAMES[normalized] then
		return false
	end

	-- Must exist in priority list
	if not PRIORITY_LOOKUP[normalized] then
		return false
	end

	return true
end

--// ============================================================
--// MOVEMENT SOUND MUTER
--// ============================================================

local MovementSounds = {
	Running = true,
	Run = true,
	Walking = true,
	Walk = true,
	Jumping = true,
	Jump = true,
	FreeFalling = true,
	Landing = true,
	Climbing = true,
	Swimming = true,
}

local function muteMovementSounds(character)

	local function checkSound(obj)

		if not obj:IsA("Sound") then
			return
		end

		local name = obj.Name
		local lowerName = string.lower(name)

		if MovementSounds[name]
			or lowerName:find("walk", 1, true)
			or lowerName:find("run", 1, true)
			or lowerName:find("jump", 1, true)
			or lowerName:find("land", 1, true)
			or lowerName:find("fall", 1, true)
			or lowerName:find("climb", 1, true)
			or lowerName:find("swim", 1, true) then

			obj.Volume = 0
			obj:Stop()
		end
	end

	for _, obj in ipairs(character:GetDescendants()) do
		checkSound(obj)
	end

	character.DescendantAdded:Connect(checkSound)
end

