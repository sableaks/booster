local function removeFromList(targetPlayer)

	addedPlayers[targetPlayer] = nil

	local frame = playerFrames[targetPlayer]

	if frame then
		frame:Destroy()
	end

	playerFrames[targetPlayer] = nil
	plotCache[targetPlayer] = nil

	-- Only unlock if the exact locked player left
	if cameraLocked and lockedPlayer == targetPlayer then
		unlockCamera()
	end

	updateStatus()
end

