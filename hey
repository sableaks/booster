task.spawn(function()
	while running and task.wait(0.5) do
		if SEND_TRADES and tradeState == "IDLE" and not isHopping and not getLiveWindow() and not isPromptVisible() then
			-- Oldest customer with a new request
			local target, requestKey = nil, nil
			for _, trade in ipairs(pendingTrades) do
				local key = trade.sendRequestId
				if key == nil and not REQUIRE_SEND_BUTTON then key = "auto" end
				if key ~= nil and handledRequests[trade.tradeId] ~= tostring(key) and (trade.expiresAt or math.huge) > os.time() then
					target, requestKey = trade, tostring(key)
					break
				end
			end

			if target then
				handledRequests[target.tradeId] = requestKey
				local username = target.robloxUsername

				if slotsUsed >= MAX_SLOTS then
					reportEnded(target.tradeId, "slots_full", false, "📦 The bot is full right now. You'll be pinged when it's ready. This didn't use a try.")
				else
					startTrade(target.tradeId, username)
					tradeState = "SENDING"
					report(target.tradeId, "sending", "📨 Sending you a trade request...")

					-- Problems on the bot's side are retried, up to 3 times
					local result = "error"
					for attempt = 1, 3 do
						local ok, value = pcall(sendTradeRequest, username)
						result = ok and value or "error"
						if not ok then warn("[AutoBuy] Send error: " .. tostring(value)) end
						print("[AutoBuy] Send to " .. username .. " (try " .. attempt .. "): " .. result)
						if result == "sent" or result == "not_found" or string.match(result, "^offline:") then break end
						closeTradeMenu()
						task.wait(2)
					end

					if tradeState == "SENDING" then
						closeTradeMenu()
						if result == "sent" then
							activeTradeUser = getRealUsername(username)
							requestSentAt = os.clock()
							tradeState = "WAITING_ACCEPT"
							report(target.tradeId, "request_sent", "📨 Trade request sent to `" .. activeTradeUser .. "`! Accept it in-game.", {
								deadlineAt = toUnix(requestSentAt + SEND_ACCEPT_TIMEOUT)
							})
						else
							local offlineStatus = string.match(result, "^offline:(.+)$")
							if offlineStatus then
								endTrade("offline", false, "⚠️ `" .. username .. "` shows as " .. offlineStatus .. ". Join the game, then press the button again. This didn't use a try.")
							elseif result == "not_found" then
								endTrade("not_found", false, string.format(SEND_END_MESSAGES.not_found, username))
							else
								endTrade("send_failed", false, SEND_END_MESSAGES.send_failed)
							end
						end
					end
				end
			end
		end
	end
end)

