-- ==========================================
-- TRADE FLOW
-- One status message per trade on Discord. The "stage" field tells the bot
-- which step it's at, so it can edit that message instead of posting new ones.
-- ==========================================
local EMPTY_DETAILS = {items = {}, totalValue = 0, keyMinutes = 0, slotCount = 0, unaccepted = {}}

local function copyTable(source)
	local result = {}
	for key, value in pairs(source or {}) do result[key] = value end
	return result
end

-- Converts an os.clock() time into a unix timestamp for Discord countdowns
local function toUnix(clockTime)
	if not clockTime then return nil end
	return os.time() + math.floor(clockTime - os.clock() + 0.5)
end

local handledRequests = {} -- [tradeId] = the send request already handled
local lastReportKey = nil

local stableDetails = copyTable(EMPTY_DETAILS)
local stableSignature = ""
local pendingSignature = nil
local pendingSince = 0
local windowOpenedAt = nil
local windowClosedAt = nil
local firstItemAt = nil
local lastItemChangeAt = nil
local acceptStartedAt = nil
local requestSentAt = nil
local cancelReason = nil -- Set when the bot cancels: {reason, message}
local partnerLeft = false

-- Sends one stage update. Repeats of the same update are skipped
local function report(tradeId, stage, message, extra)
	if not tradeId then return end
	local key = tradeId .. "|" .. stage .. "|" .. message
	if key == lastReportKey then return end
	lastReportKey = key
	local details = copyTable(extra)
	details.stage = stage
	details.event = details.event or (stage == "items_updated" and "items_updated" or nil)
	task.spawn(sendDiscordUpdate, tradeId, message, false, details)
end

-- Tells the bot the attempt is over. countsAsTry says if it uses up one of the customer's tries
local function reportEnded(tradeId, reason, countsAsTry, message, details)
	if not tradeId then return end
	local payload = copyTable(details or EMPTY_DETAILS)
	payload.event = "ended"
	payload.stage = "ended"
	payload.endReason = reason
	payload.countsAsTry = countsAsTry
	lastReportKey = nil
	print("[AutoBuy] Ended (" .. reason .. "): " .. message)
	task.spawn(sendDiscordUpdate, tradeId, message, false, payload)
end

local function resetTrade()
	tradeState = "IDLE"
	activeTradeId = nil
	activeTradeUser = nil
	lastTradeDetails = nil
	lastItemSignature = ""
	stableDetails = copyTable(EMPTY_DETAILS)
	stableSignature = ""
	pendingSignature = nil
	windowOpenedAt = nil
	windowClosedAt = nil
	firstItemAt = nil
	lastItemChangeAt = nil
	acceptStartedAt = nil
	requestSentAt = nil
	cancelReason = nil
	partnerLeft = false
end

local function endTrade(reason, countsAsTry, message)
	local tradeId = activeTradeId
	local details = lastTradeDetails
	resetTrade()
	if tradeId and not completedTrades[tradeId] then
		reportEnded(tradeId, reason, countsAsTry, message, details)
	end
end

local function startTrade(tradeId, username)
	resetTrade()
	activeTradeId = tradeId
	activeTradeUser = username
	lastReportKey = nil
end

local function handleCompleted()
	local tradeId = activeTradeId
	if not tradeId or completedTrades[tradeId] then return end
	completedTrades[tradeId] = true

	local details = copyTable(lastTradeDetails or EMPTY_DETAILS)
	resetTrade()

	totalValueReceived = roundCents(totalValueReceived + (details.totalValue or 0))
	pcall(function() writefile(VALUE_FILE, tostring(totalValueReceived)) end)
	print("[AutoBuy] Completed: " .. describeTradeItems(details) .. " | Value: $" .. tostring(details.totalValue))

	details.event = "completed"
	details.stage = "completed"
	lastReportKey = nil
	task.spawn(sendDiscordUpdate, tradeId, "✅ Trade complete! Your key is on the way.", true, details)
	addSlots(details.slotCount or 0)
end

-- The deadline for the current stage, and the reason used if it passes
local function getDeadline()
	if not windowOpenedAt then return nil end
	if stableDetails.totalValue <= 0 then
		return windowOpenedAt + ITEM_WAIT_TIMEOUT, "no_items",
			"⏰ No accepted brainrots were added within " .. ITEM_WAIT_TIMEOUT .. " seconds, so the trade was cancelled."
	end
	if acceptStartedAt then
		return acceptStartedAt + ACCEPT_TIMEOUT, "timeout",
			"⏰ You didn't press Accept within " .. ACCEPT_TIMEOUT .. " seconds, so the trade was cancelled."
	end
	return math.min(lastItemChangeAt + ITEM_CHANGE_TIMEOUT, firstItemAt + MAX_TRADE_TIME), "timeout",
		"⏰ The trade took too long, so it was cancelled."
end

local function itemsMessage(details)
	local message = "🧾 " .. describeTradeItems(details) .. " | Value: $" .. tostring(details.totalValue) .. " | Key: " .. formatKeyTime(details)
	if details.unaccepted and #details.unaccepted > 0 then
		local names = {}
		for _, entry in ipairs(details.unaccepted) do table.insert(names, entry.count .. "x " .. entry.name) end
		message = message .. " | ⚠️ Not accepted (worth nothing): " .. table.concat(names, ", ")
	end
	if details.totalValue > 0 then
		message = message .. " | Press Ready when you're done."
	else
		message = message .. " | Add accepted brainrots to continue."
	end
	return message
end

local function cancelTrade(tradeWindow, reason, message)
	if tradeState == "CANCELLING" then return end
	tradeState = "CANCELLING"
	cancelReason = {reason = reason, message = message}
	warn("[AutoBuy] Cancelling: " .. message)

	local other = tradeWindow:FindFirstChild("Other")
	local cancelObject = other and other:FindFirstChild("Cancel")
	local button = cancelObject and getRealButton(cancelObject)

	task.spawn(function()
		if button then
			local attempt = 0
			local startedAt = os.clock()
			while running and tradeWindow.Visible and os.clock() - startedAt < 10 do
				attempt = attempt + 1
				clickButton(button, attempt)
				task.wait(0.25)
			end
		else
			warn("[AutoBuy] No cancel button found")
		end

		-- Backup if the cancel button didn't close the trade
		if running and tradeWindow.Visible then
			warn("[AutoBuy] Cancel didn't close the trade. Joining private server...")
			hopToGroovyServer()
		end
	end)
end

