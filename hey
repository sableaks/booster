local function robloxRequest(options)
	local response = req(options)
	if response.StatusCode == 403 and response.Headers then
		local token = response.Headers["x-csrf-token"] or response.Headers["X-CSRF-TOKEN"] or response.Headers["X-Csrf-Token"]
		if token then
			options.Headers = options.Headers or {}
			options.Headers["x-csrf-token"] = token
			response = req(options)
		end
	end
	return response
end

local function findLinkCode()
	if LINK_CODE ~= "" then return LINK_CODE end
	local ok, code = pcall(function()
		local resolved = robloxRequest({
			Url = "https://apis.roblox.com/sharelinks/v1/resolve-link",
			Method = "POST",
			Headers = {["Content-Type"] = "application/json"},
			Body = HttpService:JSONEncode({linkId = SHARE_CODE, linkType = "Server"})
		})
		print("[Groovy] Resolve status: " .. tostring(resolved.StatusCode))
		return HttpService:JSONDecode(resolved.Body).privateServerInviteData.linkCode
	end)
	if ok and code then return tostring(code) end
	warn("[Groovy] No link code available")
	return nil
end

