									local startedAt = os.clock()

									while tradeState == "ACCEPTING_PROMPT" and prompt.Visible and os.clock() - startedAt < 10 do
										attempt = attempt + 1
										print("[AutoBuy] Click attempt " .. attempt .. " on " .. yesBtn:GetFullName())
										clickButton(yesBtn, attempt)
										task.wait(0.75)
									end

									-- Reset if the prompt never accepted
									if tradeState == "ACCEPTING_PROMPT" and prompt.Visible then
										warn("[AutoBuy] Could not click Yes after 10 seconds")
										tradeState = "IDLE"
										activeTradeId = nil
										activeTradeUser = nil
									end
								end)
							else
								warn("[AutoBuy] No Yes button found in prompt")
								tradeState = "IDLE"
								activeTradeId = nil
								activeTradeUser = nil
							end
						end
					end
				end
			end
		end
	end
	
	-- 2. Handle Live Trade Window
	if tradeState == "ACCEPTING_PROMPT" or tradeState == "WAITING_FOR_ITEM" or tradeState == "READYING" or tradeState == "ACCEPTING" then
		local tradeGui = playerGui:FindFirstChild("TradeLiveTrade")
		if tradeGui then
			local tlt = tradeGui:FindFirstChild("TradeLiveTrade")
			if tlt and tlt.Visible then
				local other = tlt:FindFirstChild("Other")
				if other then
					local details, signature = scanTradeItems(other)
					local hasValue = details.totalValue > 0

					-- Report every change to the items
					if signature ~= lastItemSignature and signature ~= "" then
						lastItemSignature = signature
						lastTradeDetails = details
						details.event = "items_updated"
						task.spawn(sendDiscordUpdate, activeTradeId, "🧾 Items: " .. describeTradeItems(details) .. " | Value: $" .. details.totalValue .. " | Estimated key: " .. formatKeyTime(details), false, details)

						-- A change means the wait starts again
						if tradeState == "READYING" or tradeState == "ACCEPTING" then
							tradeState = "READYING"
							tradeVerifiedAt = os.clock()
						end
					end

					if hasValue then
						if tradeState == "ACCEPTING_PROMPT" or tradeState == "WAITING_FOR_ITEM" then
							tradeState = "READYING"
							tradeVerifiedAt = os.clock()
							sendDiscordUpdate(activeTradeId, "✅ Items verified! Waiting 4.7 seconds before readying up...", false)
						end

						if tradeState == "READYING" then
							if os.clock() - tradeVerifiedAt >= 4.7 then
								local readyIcon = other:FindFirstChild("Ready")
								if readyIcon and readyIcon.Visible then
									tradeState = "ACCEPTING"
									sendDiscordUpdate(activeTradeId, "✅ Both players readied up. Waiting for final accept window...", false)
								end
							end
						end

						if tradeState == "ACCEPTING" then
							startSpamClicking(tlt, other)
						end
					else
						-- Nothing of value in the trade
						if tradeState == "READYING" or tradeState == "ACCEPTING" then
							tradeState = "WAITING_FOR_ITEM"
							sendDiscordUpdate(activeTradeId, "⚠️ Items were removed from the trade! Waiting for items to be added...", false)
						elseif tradeState == "ACCEPTING_PROMPT" then
							tradeState = "WAITING_FOR_ITEM"
							sendDiscordUpdate(activeTradeId, "Trade window is open. Waiting for you to add your items...", false)
						end
					end
				end
			end
		end
	end
	
	-- 3. Check for Completion Notification
	if activeTradeId then
		local notifGui = playerGui:FindFirstChild("Notification")
		if notifGui then
			local notif = notifGui:FindFirstChild("Notification")
			if notif then
				for _, child in ipairs(notif:GetChildren()) do
					if child:IsA("TextLabel") or child:IsA("TextButton") then
						local txt = child.Text
						-- Match regardless of rich text formatting
						if string.find(txt, "completed!", 1, true) and string.find(txt, activeTradeUser, 1, true) then
							-- Clear the state BEFORE the request, because the request yields
							local completedTradeId = activeTradeId
							tradeState = "IDLE"
							activeTradeId = nil
							activeTradeUser = nil
							child.Text = "Processed"

							-- Only ever report a trade as complete once
							if not completedTrades[completedTradeId] then
								completedTrades[completedTradeId] = true
								local details = lastTradeDetails or {items = {}, totalValue = 0, keyMinutes = 0}
								lastTradeDetails = nil
								lastItemSignature = ""
								totalValueReceived = roundCents(totalValueReceived + details.totalValue)
								pcall(function() writefile(VALUE_FILE, tostring(totalValueReceived)) end)
								print("[AutoBuy] Received: " .. describeTradeItems(details) .. " | Value: $" .. details.totalValue)

								details.event = "completed"
								task.spawn(sendDiscordUpdate, completedTradeId, "Complete", true, details)
							end
							break
						end
					end
				end
			end
		end
	end
end)
