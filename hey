-- ==========================================
-- MUTATION MULTIPLIERS & TRAIT BONUS
-- Keys are the game's __mutation values
-- ==========================================
local MUTATION_MULTIPLIERS = {
	Normal = 1.00,
	Gold = 1.01,
	Diamond = 1.01,
	Lava = 1.67,
	Divine = 1.76,
	Candy = 1.88,
	Rainbow = 2.02,
	Galaxy = 2.06,
	Radioactive = 2.07,
	YinYang = 2.07,
	Bloodrot = 2.16,
	Cursed = 2.24,
	Cyber = 2.29,
	Phantom = 2.55,
	Crystal = 3.17,
	Eclipse = 4.58,
}
local TRAIT_BONUS = 0.045 -- +4.5% of the base price per trait

-- Reads the mutation from the 3D model inside the card
local function getCardMutation(spacer)
	local viewport = spacer:FindFirstChild("ViewportFrame")
	local worldModel = viewport and viewport:FindFirstChild("WorldModel")
	local model = worldModel and worldModel:FindFirstChildWhichIsA("Model")
	if not model then return "Normal" end
	local mutation = model:GetAttribute("__mutation") or model:GetAttribute("Mutation")
	if type(mutation) ~= "string" or mutation == "" then return "Normal" end
	return mutation
end

-- Reads the trait icons on the card (each icon is named after its trait)
local function getCardTraits(spacer)
	local traits = {}
	local traitsFrame = spacer:FindFirstChild("Traits")
	if traitsFrame then
		for _, icon in ipairs(traitsFrame:GetChildren()) do
			if icon:IsA("ImageLabel") and icon.Name ~= "Template" and icon.Visible then
				table.insert(traits, icon.Name)
			end
		end
	end
	table.sort(traits)
	return traits
end

local function getItemPrice(basePrice, mutation, traitCount)
	local multiplier = MUTATION_MULTIPLIERS[mutation] or 1
	return basePrice * multiplier + basePrice * TRAIT_BONUS * traitCount
end

local function scanTradeItems(otherFrame)
	local details = {items = {}, totalValue = 0, keyMinutes = 0, slotCount = 0}
	local sf = otherFrame:FindFirstChild("ScrollingFrame")
	if not sf then return details, "" end

	local found = {} -- [name|mutation|traits] = item
	local count = 0
	for _, child in ipairs(sf:GetChildren()) do
		-- Dynamically skip the first instance named Template, check the rest
		if child:IsA("Frame") and child.Name == "Template" then
			count = count + 1
			if count > 1 then
				local spacer = child:FindFirstChild("Spacer")
				local title = spacer and spacer:FindFirstChild("Title")
				local entry = title and priceLookup[string.lower(title.Text)]
				if entry then
					local mutation = getCardMutation(spacer)
					local traits = getCardTraits(spacer)
					local key = entry.name .. "|" .. mutation .. "|" .. table.concat(traits, ",")
					local item = found[key]
					if not item then
						item = {
							name = entry.name,
							mutation = mutation,
							traits = traits,
							count = 0,
							basePrice = entry.price,
							price = roundCents(getItemPrice(entry.price, mutation, #traits)),
						}
						found[key] = item
					end
					item.count = item.count + 1
				end
			end
		end
	end

	local parts = {}
	for key, item in pairs(found) do
		local unitPrice = getItemPrice(item.basePrice, item.mutation, #item.traits)
		table.insert(details.items, {
			name = item.name,
			mutation = item.mutation,
			traits = item.traits,
			count = item.count,
			price = item.price,
			value = roundCents(unitPrice * item.count),
			priced = item.basePrice > 0
		})
		details.totalValue = details.totalValue + unitPrice * item.count
		table.insert(parts, key .. "x" .. item.count)
	end
	table.sort(details.items, function(a, b)
		if a.name ~= b.name then return a.name < b.name end
		return a.value > b.value
	end)
	table.sort(parts)
	-- Every item takes a slot, even ones not on the price list
	details.slotCount = math.max(count - 1, 0)
	if details.slotCount > 0 then table.insert(parts, "slots:" .. details.slotCount) end
	details.totalValue = roundCents(details.totalValue)
	details.isLifetime = details.totalValue >= LIFETIME_VALUE
	details.keyMinutes = (not details.isLifetime) and math.floor(details.totalValue * 60 + 0.5) or nil
	return details, table.concat(parts, "|")
end

local function formatKeyTime(details)
	if details.isLifetime then return "Lifetime" end
	local minutes = details.keyMinutes or 0
	return math.floor(minutes / 60) .. "h " .. (minutes % 60) .. "m"
end

local function describeTradeItems(details)
	local lines = {}
	for _, item in ipairs(details.items) do
		local priceText = item.priced and ("$" .. item.value) or "no price set"
		local tags = {}
		if item.mutation and item.mutation ~= "Normal" then table.insert(tags, item.mutation) end
		if item.traits and #item.traits > 0 then table.insert(tags, #item.traits .. " traits: " .. table.concat(item.traits, "/")) end
		local tagText = #tags > 0 and (" [" .. table.concat(tags, ", ") .. "]") or ""
		table.insert(lines, item.count .. "x " .. item.name .. tagText .. " (" .. priceText .. ")")
	end
	if #lines == 0 then return "none" end
	return table.concat(lines, ", ")
end

