local function getRealButton(yes)
	if yes:IsA("GuiButton") then return yes end
	return yes:FindFirstChildWhichIsA("GuiButton", true)
end

-- Fake tap passed to the button's handlers, in case they read it
local FAKE_INPUT = {
	UserInputType = Enum.UserInputType.Touch,
	UserInputState = Enum.UserInputState.End,
	KeyCode = Enum.KeyCode.Unknown,
	Position = Vector3.new(0, 0, 0),
	Delta = Vector3.new(0, 0, 0),
}

local CLICK_SIGNALS = {"Activated", "MouseButton1Click"}

-- Each method is a different way to press the button. None of them move the mouse except "mouse"
local CLICK_METHODS = {"firesignal", "fire", "call", "mouse"}

local function runClickMethod(btn, method)
	if method == "mouse" then
		if not (USE_MOUSE_CLICKS and mousemoveabs and mouse1press and mouse1release) then return false end
		local screenGui = btn:FindFirstAncestorOfClass("ScreenGui")
		local inset = GuiService:GetGuiInset()
		local offsetY = (screenGui and screenGui.IgnoreGuiInset) and 0 or inset.Y
		local center = btn.AbsolutePosition + (btn.AbsoluteSize / 2)
		mousemoveabs(center.X, center.Y + offsetY)
		task.wait(0.3)
		mouse1press()
		task.wait(0.05)
		mouse1release()
		return true
	end

	if method == "firesignal" then
		if not firesignal then return false end
		for _, name in ipairs(CLICK_SIGNALS) do
			if name == "Activated" then
				pcall(firesignal, btn.Activated, FAKE_INPUT, 1)
			else
				pcall(firesignal, btn[name])
			end
		end
		return true
	end

	if not getconnections then return false end
	local ran = false
	for _, name in ipairs(CLICK_SIGNALS) do
		pcall(function()
			for _, conn in ipairs(getconnections(btn[name])) do
				if method == "fire" then
					conn:Fire(FAKE_INPUT, 1)
					ran = true
				elseif method == "call" and conn.Function then
					-- Runs the game's handler function directly
					task.spawn(conn.Function, FAKE_INPUT, 1)
					ran = true
				end
			end
		end)
	end
	return ran
end

-- Used for spam clicking (Yes, Ready, Cancel): cycles through the methods
local function clickButton(btn, attempt)
	local method = CLICK_METHODS[((attempt - 1) % #CLICK_METHODS) + 1]
	if not runClickMethod(btn, method) then
		-- Method not supported, so use the first one that is
		for _, fallback in ipairs(CLICK_METHODS) do
			if runClickMethod(btn, fallback) then break end
		end
	end
end

local function startSpamClicking(tradeWindow, other)
	if isSpamClicking then return end
	local readyButton = other:FindFirstChild("ReadyButton") or tradeWindow:FindFirstChild("ReadyButton", true)
	local button = readyButton and getRealButton(readyButton)
	if not button then
		warn("[AutoBuy] No ready button found")
		return
	end

	isSpamClicking = true
	task.spawn(function()
		print("[AutoBuy] Spam clicking " .. button:GetFullName())
		local attempt = 0
		while running and tradeState == "ACCEPTING" and tradeWindow.Visible do
			attempt = attempt + 1
			clickButton(button, attempt)
			task.wait(0.25)
		end
		isSpamClicking = false
	end)
end

