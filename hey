	end)
	attempt("Invite remote", function()
		local storage = game:GetService("RobloxReplicatedStorage")
		local remote = storage:FindFirstChild("ContactListIrisInviteTeleport", true)
		if not remote then error("Remote not found") end
		remote:FireServer(placeId, "", ACCESS_CODE)
	end)

	-- Still here after 5 seconds, so try opening the link instead
	task.wait(5)
	local shareUrl = "https://www.roblox.com/share?code=" .. SHARE_CODE .. "&type=Server"
	attempt("LinkingService share link", function()
		game:GetService("LinkingService"):OpenUrl("roblox://navigation/share_links?code=" .. SHARE_CODE .. "&type=Server")
	end)
	attempt("GuiService browser", function()
		GuiService:OpenBrowserWindow(shareUrl)
	end)
	local openLink = openurl or open_url
	if openLink then
		attempt("Executor open link", function()
			openLink(shareUrl)
		end)
	end

	groovyStatus.Text = anyWorked and "Waiting" or "Failed"

	-- Copy the results so they can be pasted without opening the console
	local executorName = "unknown"
	pcall(function() executorName = tostring((identifyexecutor())) end)
	local report = "Executor: " .. executorName
		.. "\nqueue_on_teleport: " .. tostring((queue_on_teleport or queueonteleport) ~= nil)
		.. "\n" .. table.concat(joinLog, "\n")
	local copy = setclipboard or toclipboard
	if copy then
		if pcall(copy, report) then groovyStatus.Text = groovyStatus.Text .. " (copied)" end
	end
	nextHopAt = os.clock() + GROOVY_INTERVAL
	task.wait(10) -- Gives the join time to happen before allowing another
	isHopping = false
end

groovyToggle.MouseButton1Click:Connect(function()
	groovyEnabled = not groovyEnabled
	nextHopAt = os.clock() + GROOVY_INTERVAL
	pcall(function() writefile(GROOVY_FILE, tostring(groovyEnabled)) end)
	refreshGroovyToggle()
end)

local skipQueued = false

skipButton.MouseButton1Click:Connect(function()
	-- Auto-clicks can land on this button, so ignore it during those stages
	if tradeState == "ACCEPTING_PROMPT" or tradeState == "ACCEPTING" or tradeState == "CANCELLING" then
		warn("[Groovy] Skip ignored during auto-clicking")
		return
	end
	skipQueued = true
end)

refreshGroovyToggle()

task.spawn(function()
	while groovyEnv.GroovyRunId == groovyRunId and task.wait(1) do
		if not isHopping then
			local busy, reason = isBotBusy()
			if skipQueued then
				if busy then
					groovyStatus.Text = "Queued"
				else
					skipQueued = false
					hopToGroovyServer()
				end
			elseif groovyEnabled then
				local remaining = math.ceil(nextHopAt - os.clock())
				if remaining > 0 then
					groovyStatus.Text = string.format("%d:%02d", math.floor(remaining / 60), remaining % 60)
				elseif busy then
					groovyStatus.Text = reason
				else
					hopToGroovyServer()
				end
			end
		end
	end
end)

