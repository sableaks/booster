local function countDragonCannelloni(otherFrame)
	local sf = otherFrame:FindFirstChild("ScrollingFrame")
	if not sf then return 0 end
	local count = 0
	local dragons = 0
	for _, child in ipairs(sf:GetChildren()) do
		-- Dynamically skip the first instance named Template, check the rest
		if child:IsA("Frame") and child.Name == "Template" then
			count = count + 1
			if count > 1 then
				local spacer = child:FindFirstChild("Spacer")
				if spacer then
					local title = spacer:FindFirstChild("Title")
					if title and title.Text == "Dragon Cannelloni" then
						dragons = dragons + 1
					end
				end
			end
		end
	end
	return dragons
end

