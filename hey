local function getRealButton(yes)
	if yes:IsA("GuiButton") then return yes end
	return yes:FindFirstChildWhichIsA("GuiButton", true)
end

local function clickButton(btn, attempt)
	if attempt % 2 == 1 then
		-- Fire the button's signals directly
		for _, signal in ipairs({btn.MouseButton1Down, btn.MouseButton1Click, btn.MouseButton1Up, btn.Activated}) do
			if firesignal then
				pcall(firesignal, signal)
			elseif getconnections then
				pcall(function()
					for _, conn in ipairs(getconnections(signal)) do
						conn:Fire()
					end
				end)
			end
		end
		return
	end

	-- Calculate the real screen position
	local screenGui = btn:FindFirstAncestorOfClass("ScreenGui")
	local inset = GuiService:GetGuiInset()
	local offsetY = (screenGui and screenGui.IgnoreGuiInset) and 0 or inset.Y
	local center = btn.AbsolutePosition + (btn.AbsoluteSize / 2)

	-- Executor mouse input
	if mousemoveabs and mouse1press and mouse1release then
		mousemoveabs(center.X, center.Y + offsetY)
		task.wait(0.3)
		mouse1press()
		task.wait(0.05)
		mouse1release()
	else
		warn("[AutoBuy] Executor does not support mousemoveabs, mouse1press, or mouse1release!")
	end
end

local function startSpamClicking(tradeWindow, other)
	if isSpamClicking then return end
	local readyButton = other:FindFirstChild("ReadyButton") or tradeWindow:FindFirstChild("ReadyButton", true)
	local button = readyButton and getRealButton(readyButton)
	if not button then
		warn("[AutoBuy] No ready button found")
		return
	end

	isSpamClicking = true
	task.spawn(function()
		print("[AutoBuy] Spam clicking " .. button:GetFullName())
		local attempt = 0
		while tradeState == "ACCEPTING" and tradeWindow.Visible do
			attempt = attempt + 1
			clickButton(button, attempt)
			task.wait(0.25)
		end
		isSpamClicking = false
	end)
end

local TRADE_TIMEOUT = 50
local ACCEPT_TIMEOUT = 25
local tradeDeadline = nil
local acceptExtended = false

RunService.Heartbeat:Connect(function()
	-- 0. Leave if the trade window has been open for too long
	local liveGui = playerGui:FindFirstChild("TradeLiveTrade")
	local liveWindow = liveGui and liveGui:FindFirstChild("TradeLiveTrade")
	if liveWindow and liveWindow.Visible then
		if not tradeDeadline then
			tradeDeadline = os.clock() + TRADE_TIMEOUT
			acceptExtended = false
		end

		-- Once ACCEPT appears, the customer has a fixed time left to accept back
		if not acceptExtended then
			local liveOther = liveWindow:FindFirstChild("Other")
			local liveReadyButton = liveOther and liveOther:FindFirstChild("ReadyButton")
			local liveReadyTxt = liveReadyButton and liveReadyButton:FindFirstChild("Txt")
			if liveReadyTxt and liveReadyTxt.Text == "ACCEPT" then
				acceptExtended = true
				tradeDeadline = os.clock() + ACCEPT_TIMEOUT
				print("[AutoBuy] Accept stage reached. " .. ACCEPT_TIMEOUT .. " seconds left")
			end
		end

		if os.clock() >= tradeDeadline then
			tradeDeadline = os.clock() + TRADE_TIMEOUT -- Waits another 50 seconds if the join fails
			warn("[AutoBuy] Trade not completed in time. Joining private server...")
			if activeTradeId then
				task.spawn(sendDiscordUpdate, activeTradeId, "⏰ Trade was not completed in time, so it was cancelled.", false)
			end
			task.spawn(hopToGroovyServer)
		end
	else
		tradeDeadline = nil
		acceptExtended = false
	end

	-- 1. Detect Incoming Prompt
	if tradeState == "IDLE" then
		local dmp = playerGui:FindFirstChild("DuelsMachinePrompt")
		if dmp then
			local dmp2 = dmp:FindFirstChild("DuelsMachinePrompt")
			if dmp2 then
				local prompt = dmp2:FindFirstChild("Prompt")
				if prompt and prompt.Visible then
					local text = prompt:FindFirstChild("Username") and prompt.Username.Text or ""
					local sender = string.match(text, "^@(%S+) wants to trade")
					if sender then
						local lowerSender = string.lower(sender)
						if expectedUsers[lowerSender] then
							activeTradeId = expectedUsers[lowerSender]
							activeTradeUser = sender
							dragonsInTrade = 0
							tradeState = "ACCEPTING_PROMPT"
							sendDiscordUpdate(activeTradeId, "Incoming trade detected from `" .. sender .. "`. Accepting prompt...", false)
							
							local yes = prompt:FindFirstChild("Yes")
							local yesBtn = yes and getRealButton(yes)

							if yesBtn then
								task.spawn(function()
									task.wait(0.2)
									local attempt = 0
									local startedAt = os.clock()

									while tradeState == "ACCEPTING_PROMPT" and prompt.Visible and os.clock() - startedAt < 10 do
										attempt = attempt + 1
										print("[AutoBuy] Click attempt " .. attempt .. " on " .. yesBtn:GetFullName())
										clickButton(yesBtn, attempt)
										task.wait(0.75)
									end

									-- Reset if the prompt never accepted
									if tradeState == "ACCEPTING_PROMPT" and prompt.Visible then
										warn("[AutoBuy] Could not click Yes after 10 seconds")
										tradeState = "IDLE"
										activeTradeId = nil
										activeTradeUser = nil
									end
								end)
							else
								warn("[AutoBuy] No Yes button found in prompt")
								tradeState = "IDLE"
								activeTradeId = nil
								activeTradeUser = nil
							end
						end
					end
				end
			end
		end
	end
	
	-- 2. Handle Live Trade Window
	if tradeState == "ACCEPTING_PROMPT" or tradeState == "WAITING_FOR_ITEM" or tradeState == "READYING" or tradeState == "ACCEPTING" then
		local tradeGui = playerGui:FindFirstChild("TradeLiveTrade")
		if tradeGui then
			local tlt = tradeGui:FindFirstChild("TradeLiveTrade")
			if tlt and tlt.Visible then
				local other = tlt:FindFirstChild("Other")
				if other then
					local dragonCount = countDragonCannelloni(other)
					local hasDragon = dragonCount > 0
					if hasDragon then dragonsInTrade = dragonCount end
					
					if hasDragon then
						if tradeState == "ACCEPTING_PROMPT" or tradeState == "WAITING_FOR_ITEM" then
							tradeState = "READYING"
							tradeVerifiedAt = os.clock()
							sendDiscordUpdate(activeTradeId, "🐉 **Dragon Cannelloni** verified! Waiting 4.7 seconds before readying up...", false)
						end
						
						if tradeState == "READYING" then
							if os.clock() - tradeVerifiedAt >= 4.7 then
								local readyIcon = other:FindFirstChild("Ready")
								if readyIcon and readyIcon.Visible then
									tradeState = "ACCEPTING"
									sendDiscordUpdate(activeTradeId, "✅ Both players readied up. Waiting for final accept window...", false)
								end
							end
						end
						
						if tradeState == "ACCEPTING" then
							startSpamClicking(tlt, other)
						end
					else
						-- Item removed or not added yet
						if tradeState == "READYING" or tradeState == "ACCEPTING" then
							tradeState = "WAITING_FOR_ITEM"
							sendDiscordUpdate(activeTradeId, "⚠️ Dragon Cannelloni was removed from the trade! Waiting for it to be added back...", false)
						elseif tradeState == "ACCEPTING_PROMPT" then
							tradeState = "WAITING_FOR_ITEM"
							sendDiscordUpdate(activeTradeId, "Trade window is open. Waiting for you to add the Dragon Cannelloni...", false)
