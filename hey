-- PROMPT CLICK HELPERS
-- ==========================================
local function getRealButton(yes)
	if yes:IsA("GuiButton") then return yes end
	return yes:FindFirstChildWhichIsA("GuiButton", true)
end

local function clickButton(btn, attempt)
	if attempt % 2 == 1 or not USE_MOUSE_CLICKS then
		-- Fire the button's signals directly
		for _, signal in ipairs({btn.MouseButton1Down, btn.MouseButton1Click, btn.MouseButton1Up, btn.Activated}) do
			if firesignal then
				pcall(firesignal, signal)
			elseif getconnections then
				pcall(function()
					for _, conn in ipairs(getconnections(signal)) do
						conn:Fire()
					end
				end)
			end
		end
		return
	end

	-- Calculate the real screen position
	local screenGui = btn:FindFirstAncestorOfClass("ScreenGui")
	local inset = GuiService:GetGuiInset()
	local offsetY = (screenGui and screenGui.IgnoreGuiInset) and 0 or inset.Y
	local center = btn.AbsolutePosition + (btn.AbsoluteSize / 2)

	-- Executor mouse input
	if mousemoveabs and mouse1press and mouse1release then
		mousemoveabs(center.X, center.Y + offsetY)
		task.wait(0.3)
		mouse1press()
		task.wait(0.05)
		mouse1release()
	else
		warn("[AutoBuy] Executor does not support mousemoveabs, mouse1press, or mouse1release!")
	end
end

local function startSpamClicking(tradeWindow, other)
	if isSpamClicking then return end
	local readyButton = other:FindFirstChild("ReadyButton") or tradeWindow:FindFirstChild("ReadyButton", true)
	local button = readyButton and getRealButton(readyButton)
	if not button then
		warn("[AutoBuy] No ready button found")
		return
	end

	isSpamClicking = true
	task.spawn(function()
		print("[AutoBuy] Spam clicking " .. button:GetFullName())
		local attempt = 0
		while tradeState == "ACCEPTING" and tradeWindow.Visible do
			attempt = attempt + 1
			clickButton(button, attempt)
			task.wait(0.25)
		end
		isSpamClicking = false
	end)
end

local function cancelTrade(tradeWindow, reason)
	if tradeState == "CANCELLING" then return end
	tradeState = "CANCELLING"
	warn("[AutoBuy] " .. reason)
	if activeTradeId then task.spawn(sendDiscordUpdate, activeTradeId, reason, false) end

	local other = tradeWindow:FindFirstChild("Other")
	local cancelObject = other and other:FindFirstChild("Cancel")
	local button = cancelObject and getRealButton(cancelObject)

	task.spawn(function()
		if button then
			print("[AutoBuy] Spam clicking " .. button:GetFullName())
			local attempt = 0
			local startedAt = os.clock()
			while tradeWindow.Visible and os.clock() - startedAt < 10 do
				attempt = attempt + 1
				clickButton(button, attempt)
				task.wait(0.25)
			end
		else
			warn("[AutoBuy] No cancel button found")
		end

		-- Backup if the cancel button didn't close the trade
		if tradeWindow.Visible then
			warn("[AutoBuy] Cancel didn't close the trade. Joining private server...")
			hopToGroovyServer()
		end
	end)
end

local TRADE_TIMEOUT = 50
local ACCEPT_TIMEOUT = 25
local tradeDeadline = nil
local acceptExtended = false
local windowOpenedAt = nil
local windowClosedAt = nil

RunService.Heartbeat:Connect(function()
	-- 0. Timeouts, and resetting after a trade closes
	local liveWindow = getLiveWindow()
	if liveWindow then
		windowClosedAt = nil
		if not windowOpenedAt then
			windowOpenedAt = os.clock()
			tradeDeadline = nil
			acceptExtended = false
		end

		local liveOther = liveWindow:FindFirstChild("Other")
		if activeTradeId and liveOther and tradeState ~= "CANCELLING" then
			local current = scanTradeItems(liveOther)
			if current.totalValue <= 0 then
				-- No listed items yet
				tradeDeadline = nil
				acceptExtended = false
				if os.clock() - windowOpenedAt >= ITEM_WAIT_TIMEOUT then
					cancelTrade(liveWindow, "⏰ No items were added within " .. ITEM_WAIT_TIMEOUT .. " seconds, so the trade is being cancelled.")
				end
			else
				-- Items added, so the trade has 50 seconds to finish
				if not tradeDeadline then tradeDeadline = os.clock() + TRADE_TIMEOUT end

				-- Once ACCEPT appears, the customer has a fixed time left to accept back
				if not acceptExtended then
					local liveReadyButton = liveOther:FindFirstChild("ReadyButton")
					local liveReadyTxt = liveReadyButton and liveReadyButton:FindFirstChild("Txt")
					if liveReadyTxt and liveReadyTxt.Text == "ACCEPT" then
						acceptExtended = true
						tradeDeadline = os.clock() + ACCEPT_TIMEOUT
						print("[AutoBuy] Accept stage reached. " .. ACCEPT_TIMEOUT .. " seconds left")
					end
				end

				if os.clock() >= tradeDeadline then
					cancelTrade(liveWindow, "⏰ Trade was not completed in time, so it is being cancelled.")
				end
			end
		end
	else
		windowOpenedAt = nil
		tradeDeadline = nil
		acceptExtended = false

		if tradeState == "WAITING_FOR_ITEM" or tradeState == "READYING" or tradeState == "ACCEPTING" or tradeState == "CANCELLING" then
			-- Waits a few seconds in case the completion notification is still coming
			windowClosedAt = windowClosedAt or os.clock()
			if os.clock() - windowClosedAt >= 6 then
				local cancelledTradeId = activeTradeId
				local details = lastTradeDetails or {items = {}, totalValue = 0, keyMinutes = 0, slotCount = 0}
				tradeState = "IDLE"
				activeTradeId = nil
				activeTradeUser = nil
				lastTradeDetails = nil
				lastItemSignature = ""
				windowClosedAt = nil
				if cancelledTradeId and not completedTrades[cancelledTradeId] then
					details.event = "cancelled"
					task.spawn(sendDiscordUpdate, cancelledTradeId, "❌ Trade was cancelled or declined.", false, details)
				end
			end
		elseif tradeState == "ACCEPTING_PROMPT" and not isPromptVisible() and os.clock() - promptAcceptedAt >= 20 then
			-- The prompt closed but no trade window opened
			warn("[AutoBuy] Trade window never opened. Resetting")
			if activeTradeId then
				task.spawn(sendDiscordUpdate, activeTradeId, "⚠️ The trade window never opened. Please send the trade again.", false)
			end
			tradeState = "IDLE"
			activeTradeId = nil
			activeTradeUser = nil
		else
			windowClosedAt = nil
		end
	end

	-- 1. Detect Incoming Prompt
	if tradeState == "IDLE" then
		local dmp = playerGui:FindFirstChild("DuelsMachinePrompt")
		if dmp then
			local dmp2 = dmp:FindFirstChild("DuelsMachinePrompt")
			if dmp2 then
				local prompt = dmp2:FindFirstChild("Prompt")
				if prompt and prompt.Visible then
					local text = prompt:FindFirstChild("Username") and prompt.Username.Text or ""
					local sender = string.match(text, "^@(%S+) wants to trade")
					if sender then
						local lowerSender = string.lower(sender)
						if expectedUsers[lowerSender] and slotsUsed < MAX_SLOTS then
							activeTradeId = expectedUsers[lowerSender]
							activeTradeUser = sender
							lastItemSignature = ""
							lastTradeDetails = nil
							promptAcceptedAt = os.clock()
							tradeState = "ACCEPTING_PROMPT"
							sendDiscordUpdate(activeTradeId, "Incoming trade detected from `" .. sender .. "`. Accepting prompt...", false)
							
							local yes = prompt:FindFirstChild("Yes")
							local yesBtn = yes and getRealButton(yes)

							if yesBtn then
								task.spawn(function()
									task.wait(0.2)
									local attempt = 0
									local startedAt = os.clock()

									while tradeState == "ACCEPTING_PROMPT" and prompt.Visible and os.clock() - startedAt < 10 do
										attempt = attempt + 1
										print("[AutoBuy] Click attempt " .. attempt .. " on " .. yesBtn:GetFullName())
										clickButton(yesBtn, attempt)
										task.wait(0.75)
									end

									-- Reset if the prompt never accepted
									if tradeState == "ACCEPTING_PROMPT" and prompt.Visible then
										warn("[AutoBuy] Could not click Yes after 10 seconds")
										tradeState = "IDLE"
										activeTradeId = nil
										activeTradeUser = nil
									end
								end)
							else
								warn("[AutoBuy] No Yes button found in prompt")
								tradeState = "IDLE"
								activeTradeId = nil
								activeTradeUser = nil
							end
						end
					end
				end
			end
		end
	end
	
	-- 2. Handle Live Trade Window
	if tradeState == "ACCEPTING_PROMPT" or tradeState == "WAITING_FOR_ITEM" or tradeState == "READYING" or tradeState == "ACCEPTING" then
		local tradeGui = playerGui:FindFirstChild("TradeLiveTrade")
		if tradeGui then
			local tlt = tradeGui:FindFirstChild("TradeLiveTrade")
			if tlt and tlt.Visible then
				local other = tlt:FindFirstChild("Other")
				if other then
					local details, signature = scanTradeItems(other)
					local hasValue = details.totalValue > 0

					-- Report every change to the items
					if signature ~= lastItemSignature and signature ~= "" then
						lastItemSignature = signature
						lastTradeDetails = details
						details.event = "items_updated"
						task.spawn(sendDiscordUpdate, activeTradeId, "🧾 Items: " .. describeTradeItems(details) .. " | Value: $" .. details.totalValue .. " | Estimated key: " .. formatKeyTime(details), false, details)

						-- A change means the wait starts again
						if tradeState == "READYING" or tradeState == "ACCEPTING" then
							tradeState = "READYING"
							tradeVerifiedAt = os.clock()
						end
					end

					if hasValue then
						if tradeState == "ACCEPTING_PROMPT" or tradeState == "WAITING_FOR_ITEM" then
							tradeState = "READYING"
							tradeVerifiedAt = os.clock()
							sendDiscordUpdate(activeTradeId, "✅ Items verified! Waiting 4.7 seconds before readying up...", false)
						end

						if tradeState == "READYING" then
							if os.clock() - tradeVerifiedAt >= 4.7 then
								local readyIcon = other:FindFirstChild("Ready")
								if readyIcon and readyIcon.Visible then
									tradeState = "ACCEPTING"
									sendDiscordUpdate(activeTradeId, "✅ Both players readied up. Waiting for final accept window...", false)
								end
							end
						end

						if tradeState == "ACCEPTING" then
							startSpamClicking(tlt, other)
						end
					else
						-- Nothing of value in the trade
						if tradeState == "READYING" or tradeState == "ACCEPTING" then
							tradeState = "WAITING_FOR_ITEM"
							sendDiscordUpdate(activeTradeId, "⚠️ Items were removed from the trade! Waiting for items to be added...", false)
						elseif tradeState == "ACCEPTING_PROMPT" then
							tradeState = "WAITING_FOR_ITEM"
							sendDiscordUpdate(activeTradeId, "Trade window is open. Waiting for you to add your items...", false)
						end
					end
				end
			end
		end
	end
	
	-- 3. Check for Completion Notification
	if activeTradeId then
		local notifGui = playerGui:FindFirstChild("Notification")
		if notifGui then
			local notif = notifGui:FindFirstChild("Notification")
			if notif then
				for _, child in ipairs(notif:GetChildren()) do
					if child:IsA("TextLabel") or child:IsA("TextButton") then
						local txt = child.Text
						-- Match regardless of rich text formatting
						if string.find(txt, "completed!", 1, true) and string.find(txt, activeTradeUser, 1, true) then
							-- Clear the state BEFORE the request, because the request yields
							local completedTradeId = activeTradeId
							tradeState = "IDLE"
							activeTradeId = nil
							activeTradeUser = nil
							child.Text = "Processed"

							-- Only ever report a trade as complete once
							if not completedTrades[completedTradeId] then
								completedTrades[completedTradeId] = true
								local details = lastTradeDetails or {items = {}, totalValue = 0, keyMinutes = 0}
								lastTradeDetails = nil
								lastItemSignature = ""
								totalValueReceived = roundCents(totalValueReceived + details.totalValue)
								pcall(function() writefile(VALUE_FILE, tostring(totalValueReceived)) end)
								print("[AutoBuy] Received: " .. describeTradeItems(details) .. " | Value: $" .. details.totalValue)

								details.event = "completed"
								task.spawn(sendDiscordUpdate, completedTradeId, "Complete", true, details)
								addSlots(details.slotCount or 0)
							end
							break
						end
					end
				end
			end
		end
	end
end)
