track(RunService.Heartbeat:Connect(function()
	if not running then return end
	local liveWindow = getLiveWindow()
	local inWindowStates = tradeState == "WAITING_FOR_ITEM" or tradeState == "READYING" or tradeState == "ACCEPTING"
	local beforeWindowStates = tradeState == "SENDING" or tradeState == "WAITING_ACCEPT" or tradeState == "ACCEPTING_PROMPT"

	-- 1. Accept a trade request the customer sent (optional)
	if tradeState == "IDLE" and ACCEPT_INCOMING_TRADES and slotsUsed < MAX_SLOTS and isPromptVisible() then
		local prompt = playerGui.DuelsMachinePrompt.DuelsMachinePrompt.Prompt
		local text = prompt:FindFirstChild("Username") and prompt.Username.Text or ""
		local sender = string.match(text, "^@(%S+) wants to trade")
		local tradeId = sender and expectedUsers[string.lower(sender)]
		if tradeId then
			startTrade(tradeId, sender)
			promptAcceptedAt = os.clock()
			tradeState = "ACCEPTING_PROMPT"
			report(tradeId, "accepting_request", "📨 Got your trade request. Accepting it...")

			local yes = prompt:FindFirstChild("Yes")
			local yesBtn = yes and getRealButton(yes)
			if yesBtn then
				task.spawn(function()
					task.wait(0.2)
					local attempt = 0
					local startedAt = os.clock()
					while running and tradeState == "ACCEPTING_PROMPT" and prompt.Visible and os.clock() - startedAt < 10 do
						attempt = attempt + 1
						clickButton(yesBtn, attempt)
						task.wait(0.75)
					end
					if tradeState == "ACCEPTING_PROMPT" and prompt.Visible then
						endTrade("send_failed", false, "⚠️ The bot couldn't accept your trade request. Send it again. This didn't use a try.")
					end
				end)
			else
				endTrade("send_failed", false, "⚠️ The bot couldn't accept your trade request. Send it again. This didn't use a try.")
			end
		end
	end

	-- 2. Waiting for the trade window to open
	if beforeWindowStates and not liveWindow then
		if partnerLeft then
			endTrade("player_left", false, "🚪 You left the game. Join again, then press the button. This didn't use a try.")
		elseif tradeState == "WAITING_ACCEPT" and os.clock() - requestSentAt >= SEND_ACCEPT_TIMEOUT then
			endTrade("not_accepted", true, "⚠️ You didn't accept the trade request in time.")
		elseif tradeState == "ACCEPTING_PROMPT" and not isPromptVisible() and os.clock() - promptAcceptedAt >= 20 then
			endTrade("send_failed", false, "⚠️ The trade window never opened. Send the trade again. This didn't use a try.")
		end
		return
	end

	-- 3. The trade window is open
	if liveWindow and activeTradeId and (beforeWindowStates or inWindowStates or tradeState == "CANCELLING") then
		windowClosedAt = nil
		local other = liveWindow:FindFirstChild("Other")
		if not other then return end

		if beforeWindowStates then
			tradeState = "WAITING_FOR_ITEM"
			windowOpenedAt = os.clock()
			report(activeTradeId, "trade_open", "🔄 Trade open! Add your brainrots.", {
				deadlineAt = toUnix(windowOpenedAt + ITEM_WAIT_TIMEOUT)
			})
		end
		if tradeState == "CANCELLING" then return end

		-- Items only count as changed once they stay the same for a moment,
		-- because the game briefly empties the list while it redraws
		local details, signature = scanTradeItems(other)
		if signature == stableSignature then
			pendingSignature = nil
		elseif signature ~= pendingSignature then
			pendingSignature = signature
			pendingSince = os.clock()
		elseif os.clock() - pendingSince >= ITEM_STABLE_TIME then
			pendingSignature = nil
			stableSignature = signature
			stableDetails = details
			if signature ~= "" then lastTradeDetails = details end
			lastItemChangeAt = os.clock()
			acceptStartedAt = nil
			if details.totalValue > 0 and not firstItemAt then firstItemAt = os.clock() end
			if tradeState == "READYING" or tradeState == "ACCEPTING" then
				tradeState = "READYING"
				tradeVerifiedAt = os.clock()
			end
			local payload = copyTable(details)
			payload.deadlineAt = toUnix((getDeadline()))
			report(activeTradeId, "items_updated", itemsMessage(details), payload)
		end

		local hasValue = stableDetails.totalValue > 0
		if hasValue then
			if tradeState == "WAITING_FOR_ITEM" then
				tradeState = "READYING"
				tradeVerifiedAt = os.clock()
			end
			if tradeState == "READYING" and os.clock() - tradeVerifiedAt >= 4.7 then
				local readyIcon = other:FindFirstChild("Ready")
				if readyIcon and readyIcon.Visible then
					tradeState = "ACCEPTING"
				end
			end
			if tradeState == "ACCEPTING" then
				startSpamClicking(liveWindow, other)
			end

			-- The final accept stage
			if not acceptStartedAt then
				local readyButton = other:FindFirstChild("ReadyButton")
				local readyTxt = readyButton and readyButton:FindFirstChild("Txt")
				if readyTxt and string.upper(readyTxt.Text) == "ACCEPT" then
					acceptStartedAt = os.clock()
					report(activeTradeId, "accepting", "✅ The bot is ready. Press Accept!", {
						deadlineAt = toUnix(acceptStartedAt + ACCEPT_TIMEOUT)
					})
				end
			end
		elseif tradeState == "READYING" or tradeState == "ACCEPTING" then
			tradeState = "WAITING_FOR_ITEM"
		end

		-- Cancel if time ran out
		local deadline, reason, message = getDeadline()
		if deadline and os.clock() >= deadline then
			cancelTrade(liveWindow, reason, message)
		end
		return
	end

	-- 4. The trade window closed without completing
	if not liveWindow and (inWindowStates or tradeState == "CANCELLING") then
		windowClosedAt = windowClosedAt or os.clock()
		if os.clock() - windowClosedAt >= CLOSE_GRACE then
			if cancelReason then
				endTrade(cancelReason.reason, true, cancelReason.message)
			elseif partnerLeft then
				endTrade("player_left", false, "🚪 You left the game, so the trade ended. Join again, then press the button. This didn't use a try.")
			else
				endTrade("cancelled", true, "❌ The trade was cancelled.")
			end
		end
	end
end))
