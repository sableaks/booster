local function findCard(list, username)
	for _, card in ipairs(list:GetChildren()) do
		local fill = card:FindFirstChild("Fill")
		local label = fill and fill:FindFirstChild("Username")
		if label and string.lower(label.Text) == "@" .. string.lower(username) then
			return card
		end
	end
	return nil
end

local function waitFor(seconds, check)
	local startedAt = os.clock()
	while os.clock() - startedAt < seconds do
		local result = check()
		if result then return result end
		task.wait(0.1)
	end
	return nil
end

local function toggleTradeMenu(attempt)
	local leftCenter = playerGui:FindFirstChild("LeftCenter")
	local holder = leftCenter and leftCenter:FindFirstChild("LeftCenter")
	local buttons = holder and holder:FindFirstChild("Buttons")
	local openObject = buttons and buttons:FindFirstChild("TradePlayerList")
	local openButton = openObject and getRealButton(openObject)
	if not openButton then return false end
	clickButton(openButton, attempt or 1)
	return true
end

-- Returns "sent", or a reason it didn't send
local function sendTradeRequest(username)
	-- Open the trade menu
	local function menuOpen()
		local m = getTradeMenu()
		return m and m.Visible
	end
	for attempt = 1, 3 do
		if menuOpen() then break end
		if not toggleTradeMenu(attempt) then return "no_menu_button" end
		waitFor(1.5, menuOpen)
	end
	if not menuOpen() then return "menu_not_open" end

	local players, list = getPlayerList()
	local searchFrame = players and players:FindFirstChild("SearchFrame")
	local searchBox = searchFrame and searchFrame:FindFirstChild("SearchBox")
	if not (searchBox and list) then return "no_search_box" end

	-- Remove any old card for this player, then search
	local oldCard = findCard(list, username)
	if oldCard then waitFor(6, function() return oldCard.Parent == nil end) end

	-- Runs the search box's own handlers, so the phone keyboard never opens
	local function runHandlers(signal, ...)
		local args = table.pack(...)
		local ran = false
		if getconnections then
			pcall(function()
				for _, conn in ipairs(getconnections(signal)) do
					if conn.Function then
						task.spawn(conn.Function, table.unpack(args, 1, args.n))
					else
						conn:Fire(table.unpack(args, 1, args.n))
					end
					ran = true
				end
			end)
		end
		if not ran and firesignal then
			pcall(firesignal, signal, table.unpack(args, 1, args.n))
		end
	end

	runHandlers(searchBox.Focused)
	searchBox.Text = "" -- Makes sure the text actually changes
	task.wait(0.05)
	searchBox.Text = username
	task.wait(0.1)
	runHandlers(searchBox.FocusLost, true, FAKE_INPUT) -- Like pressing Enter
	pcall(function() runHandlers(searchBox.ReturnPressedFromOnScreenKeyboard) end)

	-- Close the keyboard if the game opened it
	pcall(function()
		if searchBox:IsFocused() then searchBox:ReleaseFocus(false) end
	end)

	local card = waitFor(4, function() return findCard(list, username) end)
	if not card and USE_KEYBOARD_FALLBACK then
		-- Last resort: focus the box for a moment (the keyboard may flash)
		pcall(function() searchBox:CaptureFocus() end)
		searchBox.Text = username
		task.wait(0.1)
		pcall(function() searchBox:ReleaseFocus(true) end)
		card = waitFor(4, function() return findCard(list, username) end)
	end
	print("[AutoBuy] Search for " .. username .. ": " .. (card and "found" or "not found"))
	if not card then return "not_found" end

	local fill = card:FindFirstChild("Fill")
	local status = fill and fill:FindFirstChild("Status2")
	if not (status and status.Text == "Online") then
		return "offline:" .. (status and status.Text or "unknown")
	end

	local sendObject = fill:FindFirstChild("Send")
	local sendButton = sendObject and getRealButton(sendObject)
	local sendTxt = sendObject and sendObject:FindFirstChild("Txt", true)
	if not (sendButton and sendTxt) then return "no_send_button" end

	local function sendText()
		return string.upper((string.gsub(sendTxt.Text, "%s", "")))
	end
	if sendText() ~= "SEND" then
		warn("[AutoBuy] Send button says \"" .. sendTxt.Text .. "\" instead of SEND")
		return "not_ready"
	end

	-- Try one method at a time and stop as soon as it starts sending, so it never sends twice
	local started = false
	for _, method in ipairs(CLICK_METHODS) do
		if card.Parent == nil then break end
		if runClickMethod(sendButton, method) then
			print("[AutoBuy] Pressed SEND using " .. method)
			if waitFor(1, function() return sendText() ~= "SEND" end) then
				started = true
				print("[AutoBuy] SEND worked with " .. method)
				break
			end
		end
	end
	if not started then return "click_failed" end

	-- Wait for the result
	local result = waitFor(6, function()
		if card.Parent == nil then return "gone" end
		local text = sendText()
		if text == "FAILED" then return "FAILED" end
		if text == "SEND" then return "SEND" end
		return nil
	end)
	print("[AutoBuy] Send finished: " .. tostring(result))
	if result == "FAILED" then return "failed" end
	return "sent"
end

local function closeTradeMenu()
	local menu = getTradeMenu()
