local function getRealButton(yes)
	if yes:IsA("GuiButton") then return yes end
	return yes:FindFirstChildWhichIsA("GuiButton", true)
end

local function clickButton(btn, attempt)
	if attempt % 2 == 1 then
		-- Fire the button's signals directly
		for _, signal in ipairs({btn.MouseButton1Down, btn.MouseButton1Click, btn.MouseButton1Up, btn.Activated}) do
			if firesignal then
				pcall(firesignal, signal)
			elseif getconnections then
				pcall(function()
					for _, conn in ipairs(getconnections(signal)) do
						conn:Fire()
					end
				end)
			end
		end
		return
	end

	-- Calculate the real screen position
	local screenGui = btn:FindFirstAncestorOfClass("ScreenGui")
	local inset = GuiService:GetGuiInset()
	local offsetY = (screenGui and screenGui.IgnoreGuiInset) and 0 or inset.Y
	local center = btn.AbsolutePosition + (btn.AbsoluteSize / 2)

	-- Executor mouse input
	if mousemoveabs and mouse1press and mouse1release then
		mousemoveabs(center.X, center.Y + offsetY)
		task.wait(0.3)
		mouse1press()
		task.wait(0.05)
		mouse1release()
	else
		warn("[AutoBuy] Executor does not support mousemoveabs, mouse1press, or mouse1release!")
	end
end

